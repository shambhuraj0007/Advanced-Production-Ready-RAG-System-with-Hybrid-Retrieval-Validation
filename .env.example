# =======================================================
# API KEYS
# =======================================================
# Google Gemini API Key (Default provider: 'gemini')
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (High-speed LLM provider: 'groq')
# Get key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Optional provider: 'openai')
# OPENAI_API_KEY=your_openai_api_key_here

# Web Search Tool (Optional)
TAVILY_API_KEY=your_tavily_api_key_here

# =======================================================
# RAG SYSTEM CONFIGURATION (Auto-loaded into code)
# =======================================================
# Provider to use: "gemini", "groq", or "openai"
RAG_PROVIDER=gemini

# Models (Leave empty to use smart defaults for each provider)
# Gemini default:  gemini-1.5-flash / models/text-embedding-004
# Groq default:    llama-3.3-70b-versatile / all-MiniLM-L6-v2
# OpenAI default:  gpt-4o-mini / text-embedding-3-small
RAG_LLM_MODEL=
RAG_EMBEDDING_MODEL=

# Vector Storage Directory
RAG_PERSIST_DIRECTORY=./chroma_db

# Core Features (true/false)
RAG_USE_RERANKING=true
RAG_RERANK_TOP_K=3
RAG_USE_MEMORY=true
RAG_USE_HYBRID_SEARCH=true
RAG_HYBRID_ALPHA=0.5

# Advanced Intelligence
RAG_USE_QUERY_ROUTING=true
RAG_USE_QUERY_REWRITING=false
RAG_USE_ANSWER_VALIDATION=false

# External Tools
RAG_USE_TOOLS=true
RAG_ENABLE_CALCULATOR=true
RAG_ENABLE_WEB_SEARCH=false
